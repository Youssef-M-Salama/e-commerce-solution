{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "cs": "Data Source=.;Initial Catalog=EcommerceSolution;Integrated Security=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "YourVeryLongSecretKeyMustBeAtLeast32CharactersLongForSecurity",
    "Issuer": "ECommerceAPI",
    "Audience": "ECommerceUsers",
    "ExpirationInDays": 7
  }
}
